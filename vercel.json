{
  "functions": {
    "api/fax-v3/[action].js": { "maxDuration": 60 },
    "api/send-fax.js": { "maxDuration": 60 },
    "api/fax-status.js": { "maxDuration": 30 },
    "api/ringcentral-contacts.js": { "maxDuration": 60 }
  },
  "rewrites": [
    {
      "source": "/auth/callback",
      "destination": "/welcome-email-sender/callback.html"
    },
    {
      "source": "/auth/callback.html",
      "destination": "/welcome-email-sender/callback.html"
    }
  ],
  "redirects": [
    {
      "source": "/fax-sender-v3",
      "destination": "/fax-sender/",
      "permanent": false
    },
    {
      "source": "/fax-sender-v3/:path*",
      "destination": "/fax-sender/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/fax-sender/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "Referrer-Policy", "value": "same-origin" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/auth/callback",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "git": {
    "deploymentEnabled": {
      "development/fax-v3-phase1": false
    }
  }
}
