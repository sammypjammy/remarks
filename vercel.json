{
  "rewrites": [
    {
      "source": "/auth/callback",
      "destination": "/welcome-email-sender/callback.html"
    },
    {
      "source": "/auth/callback.html",
      "destination": "/welcome-email-sender/callback.html"
    }
  ],
  "headers": [
    {
      "source": "/auth/callback",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
