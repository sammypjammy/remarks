{
  "functions": {
    "api/send-fax.js": { "maxDuration": 60 },
    "api/fax-status.js": { "maxDuration": 30 }
  },
  "rewrites": [
    {
      "source": "/auth/callback",
      "destination": "/welcome-email-sender/callback.html"
    },
    {
      "source": "/auth/callback.html",
      "destination": "/welcome-email-sender/callback.html"
    }
  ],
  "headers": [
    {
      "source": "/auth/callback",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
