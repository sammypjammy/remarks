{
  "manifest_version": 3,
  "name": "Packard SSA Page Review (Development)",
  "version": "0.3.0",
  "description": "Opens the SSA disability application and selects one exact saved-application navigation control. No client profile or form filling.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Review SSA page"
  },
  "permissions": ["activeTab", "scripting"],
  "key": "",
  "host_permissions": ["https://secure.ssa.gov/*"],
  "externally_connectable": {
    "matches": ["https://packardtoolkit.vercel.app/*", "http://localhost/*", "http://127.0.0.1/*"]
  },
  "background": { "service_worker": "background.js", "type": "module" },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'; form-action 'none'; base-uri 'none'"
  }
}
