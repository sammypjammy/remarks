{
  "manifest_version": 3,
  "name": "Packard SSA Synthetic Practice",
  "version": "0.4.0",
  "description": "Chrome synthetic practice with an explicitly approved Toolkit pilot connection. No SSA access.",
  "action": {
    "default_popup": "launcher.html",
    "default_title": "Open synthetic practice"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'; form-action 'none'; base-uri 'none'"
  },
  "key": "",
  "externally_connectable": {
    "matches": [
      "http://127.0.0.1/*",
      "http://localhost/*",
      "https://packardtoolkit.vercel.app/*"
    ]
  }
}
